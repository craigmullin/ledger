rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.ownerUserId == request.auth.uid; }
    function ownsNew() { return signedIn() && request.resource.data.ownerUserId == request.auth.uid; }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /{collection}/{documentId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew();
      allow update: if ownsExisting() && ownsNew();
    }
  }
}
